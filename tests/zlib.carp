(load "Test.carp")

(load "zlib.carp")

(use-all ZLib Test)

(defn from-success [r]
  (match r (Result.Success s) s (Result.Error _) (ZBytes.init 0 @"")))

; a string of `n` copies of "a" followed by a distinct trailing "b", so the
; total length is `n+1` and the final byte is unmistakable in a round-trip.
(defn boundary-input [n] (String.append &(String.repeat n "a") "b"))

(deftest test
  (assert-true test
    (Result.success? &(deflate "hi"))
    "deflation returns success")
  (assert-true test
    (Result.success? &(inflate (from-success (deflate "hi"))))
    "deflation->inflation returns success")
  (assert-equal test
    &(Result.Success @"hi")
    &(inflate (from-success (deflate "hi")))
    "deflation->inflation round-trip is exact")
  (assert-equal test
    &(Result.Error @"Data Error")
    &(inflate (ZBytes.init 3 @"hi"))
    "inflating random data returns data error")
  (assert-equal test
    &(Result.Success @"hi")
    &(inflate (from-success (deflate-with "hi" (ZLevel.NoCompression))))
    "round-trip with NoCompression")
  (assert-equal test
    &(Result.Success @"hi")
    &(inflate (from-success (deflate-with "hi" (ZLevel.BestSpeed))))
    "round-trip with BestSpeed")
  (assert-equal test
    &(Result.Success @"hi")
    &(inflate (from-success (deflate-with "hi" (ZLevel.BestCompression))))
    "round-trip with BestCompression")
  (assert-equal test
    &(Result.Success @"hi")
    &(inflate (from-success (deflate-with "hi" (ZLevel.DefaultCompression))))
    "round-trip with DefaultCompression")
  (assert-equal test
    &(Result.Success
      @"the quick brown fox jumps over the lazy dog, again and again and again")
    &(inflate
      (from-success
        (deflate
          "the quick brown fox jumps over the lazy dog, again and again and again")))
    "round-trip with larger input")
  ; regression: deflating the empty string used to abort, because the compress
  ; loop broke on zero input before the mandatory Z_FINISH pass.
  (assert-true test
    (Result.success? &(deflate ""))
    "deflating the empty string returns success")
  (assert-equal test
    &(Result.Success @"")
    &(inflate (from-success (deflate "")))
    "empty-string deflate->inflate round-trip is exact")
  ; regression: an input whose length is an exact multiple of CHUNK (16384)
  ; plus one used to drop its final byte, because the deflate loop signalled
  ; Z_FINISH one byte early and exited before feeding the last byte.
  (assert-equal test
    &(Result.Success (boundary-input 16384))
    &(inflate (from-success (deflate &(boundary-input 16384))))
    "round-trip preserves the final byte at CHUNK+1 bytes (16385)")
  (assert-equal test
    &(Result.Success (boundary-input 32768))
    &(inflate (from-success (deflate &(boundary-input 32768))))
    "round-trip preserves the final byte at 2*CHUNK+1 bytes (32769)")
  ; copying has to go by `len`: the payload is binary and contains NUL bytes,
  ; so a strlen-based copy would truncate it.
  (let-do [orig (from-success (deflate &(boundary-input 16384)))]
    (assert-equal test
      &(Result.Success (boundary-input 16384))
      &(inflate @&orig)
      "round-trip through a copied ZBytes preserves the whole payload")))
